# Copia este archivo como .env (solo para probar en tu computadora).
# En el hosting (Render) estas variables se ponen en el panel "Environment".
# NUNCA subas el archivo .env a GitHub ni lo compartas en chats.

# Llave secreta (sk_test_ en pruebas, sk_live_ en producción)
STRIPE_SECRET_KEY=sk_test_PEGA_AQUI_TU_LLAVE_SECRETA

# Llave publicable (pk_test_ / pk_live_)
STRIPE_PUBLISHABLE_KEY=pk_test_PEGA_AQUI_TU_LLAVE_PUBLICABLE

# Secreto del webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_PEGA_AQUI_TU_SECRETO

# PayPal (developer.paypal.com → Apps & Credentials). Empieza con sandbox (pruebas);
# cuando todo funcione, crea la app "Live", cambia las llaves y pon PAYPAL_MODO=live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODO=sandbox

# Contraseña para entrar a /admin.html (ver ventas). Usa una larga.
ADMIN_PASSWORD=cambia-esta-contrasena

# Tus códigos de afiliada de Amazon Associates, uno por tienda de Amazon:
# AMAZON_TAG_MX para amazon.com.mx (p. ej. sunshine-20) y AMAZON_TAG_US para amazon.com (p. ej. sunshine0a-20).
# Déjalo vacío si no eres afiliada: los botones de Amazon siguen funcionando.
AMAZON_TAG_MX=
AMAZON_TAG_US=

# Impuestos automáticos de Stripe (sales tax en EE. UU., IVA, etc.). Pon 1 SOLO después de
# configurar Stripe Tax en tu Dashboard (Settings → Tax).
STRIPE_TAX=0

# URL pública. En Render se detecta sola; en local:
DOMAIN=http://localhost:4242
PORT=4242
